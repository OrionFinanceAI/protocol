{
  "name": "@orion-finance/protocol",
  "description": "Orion Finance Protocol",
  "version": "2.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "author": {
    "name": "Orion Finance",
    "url": "https://github.com/OrionFinanceAI"
  },
  "scripts": {
    "build": "pnpm clean && cross-env TS_NODE_TRANSPILE_ONLY=true hardhat build",
    "build:sepolia": "pnpm clean && cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile --network sepolia",
    "clean": "rimraf ./artifacts ./cache ./types ./coverage coverage.json",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "compile:sepolia": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile --network sepolia",
    "deploy:sepolia": "hardhat run protocol-ops/deploy.ts --network sepolia",
    "lint": "pnpm lint:sol && pnpm lint:ts && pnpm prettier:check",
    "lint:sol": "solhint --noPoster --max-warnings 20 \"contracts/**/*.sol\"",
    "lint:ts": "eslint --ext .js,.ts .",
    "typechain:generate": "pnpm compile",
    "typechain": "pnpm typechain:generate",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "test:sepolia": "hardhat test --network sepolia",
    "docgen": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile && node scripts/run-docgen.mjs",
    "prettier:check": "prettier --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "slither": "bash scripts/run-slither.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.12",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "3.0.22",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.17.0",
    "hardhat": "^3.12.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.3.1",
    "rimraf": "^6.1.3",
    "solhint": "^6.2.3",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-docgen": "0.6.0-beta.36",
    "typechain": "^8.3.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@morpho-org/morpho-blue": "^1.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@uniswap/v3-core": "1.0.2-solc-0.8-simulate",
    "@uniswap/v3-periphery": "^1.4.4"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
